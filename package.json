{
  "name": "jeux",
  "version": "1.0.0",
  "private": true,
  "description": "Jeux de pouvoir : la théorie des jeux appliquée à la politique belge (focus : crise budgétaire de l'Arizona, novembre 2026)",
  "type": "module",
  "scripts": {
    "build": "eleventy && pagefind --site _site --glob \"**/*.html\"",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource/spectral": "^5.2.8",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "pagefind": "^1.4.0"
  }
}
